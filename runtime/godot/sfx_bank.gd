extends Node
## Easy SFX bank — add as an autoload named SfxBank (the export does this for you).
##
##   SfxBank.play("coin")                 # one-shot (random variant when the sound has several)
##   SfxBank.play("footstep", -6.0, 1.1)  # volume dB, pitch scale
##   SfxBank.blip("blip_kid")             # typing blip: random variant + tiny pitch wobble
##   SfxBank.play_music("village_day")    # looping music (cross-fades), stop_music()
##
## Streams are the exported .wav (AudioStreamWAV) / .ogg (AudioStreamOggVorbis) files listed in
## res://easysfx/bank.sfxbank.json. Generated by Easy SFX (MIT).

signal music_changed(id: String)

const MANIFEST := "res://easysfx/bank.sfxbank.json"

@export var voices := 8
@export var sfx_bus := &"Master"
@export var music_bus := &"Master"

var manifest: Dictionary = {}
var sounds: Dictionary = {}  # id -> Array[AudioStream]
var tracks: Dictionary = {}  # id -> AudioStream
var current_music := ""
var _pool: Array[AudioStreamPlayer] = []
var _next := 0
var _music: AudioStreamPlayer
var _music_old: AudioStreamPlayer
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_rng.seed = 7
	for i in voices:
		var p := AudioStreamPlayer.new()
		p.bus = sfx_bus
		add_child(p)
		_pool.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = music_bus
	add_child(_music)
	_music_old = AudioStreamPlayer.new()
	_music_old.bus = music_bus
	add_child(_music_old)
	if FileAccess.file_exists(MANIFEST):
		load_manifest(MANIFEST)


## Load (or reload) a bank manifest. Returns false when the file is missing or broken.
func load_manifest(path: String) -> bool:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_warning("SfxBank: cannot open %s" % path)
		return false
	var data = JSON.parse_string(f.get_as_text())
	if typeof(data) != TYPE_DICTIONARY:
		push_warning("SfxBank: bad manifest %s" % path)
		return false
	manifest = data
	sounds.clear()
	tracks.clear()
	for s in data.get("sounds", []):
		var arr: Array[AudioStream] = []
		for c in s["clips"]:
			var st = load(c["file"])
			if st:
				arr.append(st)
			else:
				push_warning("SfxBank: missing %s" % c["file"])
		sounds[s["id"]] = arr
	for t in data.get("tracks", []):
		var st = load(t["file"])
		if st == null:
			push_warning("SfxBank: missing %s" % t["file"])
			continue
		if t.get("loop", true):
			if st is AudioStreamOggVorbis:
				st.loop = true
			elif st is AudioStreamWAV:
				st.loop_mode = AudioStreamWAV.LOOP_FORWARD
				st.loop_begin = 0
				st.loop_end = int(t.get("samples", 0))
		tracks[t["id"]] = st
	return true


func has_sound(id: String) -> bool:
	return sounds.has(id) and not sounds[id].is_empty()


## AudioStream for a sound (variant -1 = random).
func stream(id: String, variant := -1) -> AudioStream:
	if not has_sound(id):
		return null
	var arr: Array = sounds[id]
	var i := _rng.randi_range(0, arr.size() - 1) if variant < 0 else clampi(variant, 0, arr.size() - 1)
	return arr[i]


func play(id: String, volume_db := 0.0, pitch := 1.0, variant := -1) -> AudioStreamPlayer:
	var st := stream(id, variant)
	if st == null:
		push_warning("SfxBank: unknown sound %s" % id)
		return null
	var p := _pool[_next]
	_next = (_next + 1) % _pool.size()
	p.stream = st
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()
	return p


## Typing blip for dialogue: random variant, ±3% pitch.
func blip(id: String, volume_db := -4.0) -> AudioStreamPlayer:
	return play(id, volume_db, _rng.randf_range(0.97, 1.03))


func play_music(id: String, fade := 0.6, volume_db := -4.0) -> void:
	if not tracks.has(id):
		push_warning("SfxBank: unknown track %s" % id)
		return
	if current_music == id and _music.playing:
		return
	var old := _music
	_music = _music_old
	_music_old = old
	_music.stream = tracks[id]
	_music.volume_db = -40.0 if fade > 0.0 else volume_db
	_music.play()
	if fade > 0.0:
		var tw := create_tween().set_parallel()
		tw.tween_property(_music, "volume_db", volume_db, fade)
		if _music_old.playing:
			tw.tween_property(_music_old, "volume_db", -40.0, fade)
			tw.chain().tween_callback(_music_old.stop)
	else:
		_music_old.stop()
	current_music = id
	music_changed.emit(id)


func stop_music(fade := 0.4) -> void:
	current_music = ""
	if fade <= 0.0:
		_music.stop()
		return
	var tw := create_tween()
	tw.tween_property(_music, "volume_db", -40.0, fade)
	tw.tween_callback(_music.stop)
